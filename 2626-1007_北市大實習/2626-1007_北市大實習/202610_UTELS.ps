%%BeginProlog
initmatrix
/ps { print flush } def
/home { newpath 0 pgtop moveto } def
/mf { statusdict /manualfeed true put
 } def
/af { statusdict /manualfeed false put } def
/jobname (-) def
userdict /jobname jobname put
clippath pathbbox pop pop exch pop 0 exch translate
clippath pathbbox /pgtop exch def pop pop pop
/ShowEqui 	% HEIGHT NCHAR STRING ShowEqui
	{
		% stack is HEIGHT NCHAR STRING
		dup
		% stack is HEIGHT NCHAR STRING STRING 
		stringwidth pop exch
		% stack is HEIGHT NCHAR XWIDTH STRING
		4 1 roll
		% stack is STRING HEIGHT NCHAR XWIDTH
		exch div   
		% stack is STRING HEIGHT EXTRA_PER_CHARACTER
		sub
		% stack is STRING EXTRAX
		exch  0 exch  ashow
	}
	def
/plaid {		
		unit /xmin exch def 	
		unit /dx exch def 	
		unit /xmax exch def	
		unit /ymin exch def 	
		unit /dy exch def 	
		unit /ymax exch def	
		/strn exch def	
	
		xmin dx xmax 			% loop over x	
			{ ymin dy ymax 		% loop over y	
				{ exch dup 3 2 roll dx dy 4 2 roll	
					maskit   	
				} for 	
				pop 	
			} for	
} def	
	
	
/maskit {	
		1 setgray	
		gsave	
		4 copy	
		translate	
		scale	
		6 6 	
		false	
		[6 0 0 6 0 0]	
		strn	
		imagemask	
		% return to initial position	
		4 2 roll	
		1 exch div exch  1 exch div exch  	
		scale	
		neg exch neg exch 	
		translate	
		grestore	
} def	
/unit { 0.072 mul } def 
/m { unit exch unit exch moveto } def 
/n { unit exch unit exch rlineto } def 
/l { unit exch unit exch lineto } def 
/sn { stroke newpath } def
/cgf { closepath gsave  0 setgray fill grestore stroke } def
af
1 setlinecap 1 setlinejoin newpath
